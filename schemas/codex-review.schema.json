{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-review.schema.json",
  "title": "Codex Review Outputs",
  "description": "Structured outputs accepted from the Codex reviewer adapter. Runtime calls constrain codex exec with the per-phase model schema; this file is the static union for documentation and tooling. V0.3: issues carry correction_action/focus_area/change_scope/origin; initial/final reviews carry acceptance_coverage; closure outcomes and final results carry correction recommendations with material progress. V0.3-RC1: acceptance coverage reports stable acceptance ids against the Contract-owned current Acceptance Baseline; late BLOCKING issues without valid origin provenance fail closed (never downgraded).",
  "oneOf": [
    {
      "$ref": "#/$defs/initial_review"
    },
    {
      "$ref": "#/$defs/closure_review"
    },
    {
      "$ref": "#/$defs/final_review"
    }
  ],
  "$defs": {
    "AcceptanceCoverageEntry": {
      "description": "V0.3 C4 §40 + RC1 B403: explicit accounting for one acceptance\ncriterion of the CURRENT Contract baseline.\n\nCoverage is reported by stable acceptance ID (``acceptance_id``);\n``criterion`` is the display echo. The invariant is that acceptance\ncriteria may not silently disappear from review: a FAIL entry must\nname the BLOCKING issue (by exact title) that carries the criterion\nin the same result. ``acceptance_id`` is optional only for legacy\npre-RC1 persisted coverage (ids are assigned in recorded order by\nthe compatibility rule).",
      "properties": {
        "criterion": {
          "title": "Criterion",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "issue_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Title"
        },
        "acceptance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Id"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "status"
      ],
      "title": "AcceptanceCoverageEntry",
      "type": "object"
    },
    "CorrectionAction": {
      "enum": [
        "FULL_REVISION",
        "FOCUSED_REVISION",
        "ABLATION",
        "HUMAN_DECISION",
        "STOP"
      ],
      "title": "CorrectionAction",
      "type": "string"
    },
    "FocusArea": {
      "enum": [
        "BEHAVIOR",
        "DATA",
        "INTEGRATION",
        "VALIDATION",
        "OPERABILITY",
        "PERFORMANCE",
        "SECURITY",
        "COMPATIBILITY",
        "OTHER"
      ],
      "title": "FocusArea",
      "type": "string"
    },
    "Issue": {
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/IssueCategory",
          "default": "DESIGN"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity",
          "default": "NON_BLOCKING"
        },
        "status": {
          "$ref": "#/$defs/IssueStatus",
          "default": "OPEN"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "problem": {
          "default": "",
          "title": "Problem",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "impact": {
          "default": "",
          "title": "Impact",
          "type": "string"
        },
        "acceptance": {
          "items": {
            "type": "string"
          },
          "title": "Acceptance",
          "type": "array"
        },
        "introduced_round": {
          "default": 1,
          "title": "Introduced Round",
          "type": "integer"
        },
        "provenance": {
          "default": "INITIAL_REVIEW",
          "title": "Provenance",
          "type": "string"
        },
        "based_on_task_revision": {
          "default": 1,
          "title": "Based On Task Revision",
          "type": "integer"
        },
        "addressed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Addressed By"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "why_not_detected_initially": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Not Detected Initially"
        },
        "correction_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrectionAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "focus_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusArea"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "change_scope": {
          "items": {
            "type": "string"
          },
          "title": "Change Scope",
          "type": "array"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/NewIssueOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "covered_by_decisions": {
          "items": {
            "type": "string"
          },
          "title": "Covered By Decisions",
          "type": "array"
        },
        "covered_by_authority": {
          "items": {
            "type": "string"
          },
          "title": "Covered By Authority",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueCategory": {
      "enum": [
        "DESIGN",
        "REQUIREMENT",
        "FACT",
        "REGRESSION",
        "SUGGESTION"
      ],
      "title": "IssueCategory",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "BLOCKING",
        "NON_BLOCKING"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "IssueStatus": {
      "enum": [
        "OPEN",
        "ADDRESSED",
        "RESOLVED",
        "NEED_HUMAN",
        "ACCEPTED_RISK",
        "SUPERSEDED"
      ],
      "title": "IssueStatus",
      "type": "string"
    },
    "NewIssueOrigin": {
      "enum": [
        "INTRODUCED_BY_CORRECTION",
        "PREVIOUS_REVIEW_MISS",
        "NEW_EVIDENCE",
        "DIRECTLY_REQUIRED_FOR_CLOSURE"
      ],
      "title": "NewIssueOrigin",
      "type": "string"
    },
    "IssueOutcome": {
      "properties": {
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "resolution": {
          "title": "Resolution",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "correction_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrectionAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "focus_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusArea"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material_progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "issue_id",
        "resolution"
      ],
      "title": "IssueOutcome",
      "type": "object"
    },
    "MaterialProgress": {
      "enum": [
        "PROGRESSED",
        "NO_PROGRESS"
      ],
      "title": "MaterialProgress",
      "type": "string"
    },
    "CorrectionRecommendation": {
      "description": "V0.3 C2: reviewer recommendation of the next correction step for\none unresolved blocking issue. The orchestrator routes\nmechanically; unknown/malformed actions already failed closed at\nthe enum boundary.",
      "properties": {
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "correction_action": {
          "$ref": "#/$defs/CorrectionAction"
        },
        "focus_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusArea"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material_progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "correction_action"
      ],
      "title": "CorrectionRecommendation",
      "type": "object"
    },
    "initial_review": {
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "acceptance_coverage": {
          "items": {
            "$ref": "#/$defs/AcceptanceCoverageEntry"
          },
          "title": "Acceptance Coverage",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "type": "object",
      "description": "InitialReviewResult — structured output for the initial review phase."
    },
    "closure_review": {
      "properties": {
        "issue_outcomes": {
          "items": {
            "$ref": "#/$defs/IssueOutcome"
          },
          "title": "Issue Outcomes",
          "type": "array"
        },
        "new_issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "New Issues",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "type": "object",
      "description": "ClosureReviewResult — structured output for the closure review phase."
    },
    "final_review": {
      "properties": {
        "satisfies_requirement": {
          "default": false,
          "title": "Satisfies Requirement",
          "type": "boolean"
        },
        "unresolved_issue_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Issue Ids",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "acceptance_coverage": {
          "items": {
            "$ref": "#/$defs/AcceptanceCoverageEntry"
          },
          "title": "Acceptance Coverage",
          "type": "array"
        },
        "correction_recommendations": {
          "items": {
            "$ref": "#/$defs/CorrectionRecommendation"
          },
          "title": "Correction Recommendations",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "type": "object",
      "description": "FinalReviewResult — structured output for the final review phase."
    }
  }
}
